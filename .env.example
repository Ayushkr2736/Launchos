# -----------------------------------------------------------------------------
# LaunchOS Environment
# Copy to .env and fill in values. Never commit real secrets.
# -----------------------------------------------------------------------------

# Node
NODE_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=3001
API_CORS_ORIGIN=http://localhost:1420

# PostgreSQL (matches docker/docker-compose.yml defaults)
POSTGRES_USER=launchos
POSTGRES_PASSWORD=launchos
POSTGRES_DB=launchos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://launchos:launchos@localhost:5432/launchos?schema=public

# Prisma
PRISMA_LOG_LEVEL=warn

# Desktop (Vite)
VITE_API_BASE_URL=http://localhost:3001
