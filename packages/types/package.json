{
  "name": "@launchos/types",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Shared TypeScript contracts for LaunchOS apps and services",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo coverage"
  },
  "devDependencies": {
    "@launchos/eslint-config": "workspace:*",
    "@launchos/typescript-config": "workspace:*",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
